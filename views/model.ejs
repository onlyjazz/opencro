<%- include('partials/hero', {
  headline: 'Model: What risks really matter?',
  bridge: 'Your revenue logic can break in founders, team, design, development, deployment, commercialization, often in all 6.'
}) %>

<!-- Inheritance Line -->
<section class="section">
  <div class="container">
    <div class="inheritance-path">
      <span class="tier-step tier-prev">Foundation</span>
      <span class="tier-arrow">→</span>
      <span class="tier-step">Model</span>
      <span class="tier-arrow">→</span>
      <span class="tier-step tier-next">Operate</span>
      <span class="tier-arrow">→</span>
      <span class="tier-step tier-next">Assure</span>
    </div>
  </div>
</section>

<!-- Are you ready? -->
<section class="section">
  <div class="container">
    <h2>Model: Make risk measurable</h2>
    <div class="section-highlight">
      <p><strong>Model includes Foundation plus:</strong></p>
      <ul>
        <li>Architecture review</li>
        <li>Business threat analysis (assets, entry points, threats, countermeasures)</li>
        <li>Your exploitability today + risk structure</li>
      </ul>
    </div>
  </div>
</section>

<!-- Pricing -->
<section class="section">
  <div class="container text-center">
    <h2>Pricing</h2>
    <div class="pricing-large">
      <span class="pricing-value">$6K</span>
      <p class="pricing-subtext">Fixed outcome. Fixed price.</p>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section">
  <div class="container">
    <div class="buy-paths">
      <div class="buy-path">
        <h3>Ready to Model?</h3>
        <p class="buy-description">Tell us about your system and timeline</p>
        <a href="https://calendly.com/danny-lieberman/1-1-call" target="_blank" class="cta-primary">Schedule a call</a>
      </div>
      <div class="buy-path">
        <h3>Already in submission phase?</h3>
        <p class="buy-description">Assure prepares you for FDA Cyber submission in one engagement.</p>
        <a href="/assure" class="cta-primary">Assure</a>
      </div>
    </div>
    <div class="mt-4 text-center">
      <a href="/stress-test" class="cta-secondary">Stress-test your system</a>
    </div>
  </div>
</section>

<!-- Comparison note -->
<section class="section">
  <div class="container text-center">
    <p class="text-gray comparison-note">
      The Model program is perfect if you're still in architecture phase.
      <br><br>
      If you're heading to submission in the next 6-9 months, Assure prepares you for FDA Cyber submission in one engagement.
    </p>
  </div>
</section>
