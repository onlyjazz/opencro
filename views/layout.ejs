<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Identify where your MedTech company breaks. OpenCRO provides risk analysis for AI-enabled medical devices—prioritize the cyber and privacy risks that matter most.' %>">
  <title>OpenCRO - Identify where your MedTech company breaks. Prioritize the risks that matter most. Fixed outcome. Fixed price.</title>
  <!-- Open Graph Metadata -->
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : 'Identify where your company breaks.' %>">
  <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : 'Identify where your MedTech company breaks. Prioritize the risks that matter most. Fixed outcome. Fixed price.' %>">
  <meta property="og:image" content="https://opencro.com/images/opencro-logo.png?v=1">
  <meta property="og:url" content="https://opencro.com/">
  <meta name="author" content="Danny Lieberman">
  <!-- Preload CSS to improve performance -->
  <link rel="preload" href="/css/main.min.css" as="style">
  <link rel="stylesheet" href="/css/main.min.css">
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <%- body %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
