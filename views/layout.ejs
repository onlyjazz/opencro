<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Identify where your MedTech company breaks. OpenCRO provides risk analysis for AI-enabled medical devices—prioritize the cyber and privacy risks that matter most.' %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %>
  <meta name="robots" content="noindex, nofollow">
  <% } %>
  <title>OpenCRO - Your science works. Your value exposed - OpenCRO identifies the cyber and privacy threats most likely to impact revenue, regulatory approval, reputation, and patients.</title>
  <!-- Open Graph Metadata -->
  <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : 'Your science works. Your value exposed.' %>">
  <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : 'OpenCRO identifies the cyber and privacy threats most likely to impact revenue, regulatory approval, reputation, and patients.' %>">
  <meta property="og:image" content="https://opencro.com/images/opencro-logo.png?v=1">
  <meta property="og:url" content="https://opencro.com/">
  <meta name="author" content="Danny Lieberman">
  <!-- Preload CSS to improve performance -->
  <link rel="preload" href="/css/main.min.css?v=2" as="style">
  <link rel="stylesheet" href="/css/main.min.css?v=2">
</head>
<body>
  <%- include('partials/nav') %>
  <main>
    <%- body %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
